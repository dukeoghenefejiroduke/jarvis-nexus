# JARVIS Nexus Environment Configuration
# Set MODEL_PROVIDER=mock for offline local testing (default)
# Set MODEL_PROVIDER=nebius to use Nebius Token Factory & NVIDIA Nemotron

MODEL_PROVIDER=mock
NEBIUS_API_KEY=your_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
